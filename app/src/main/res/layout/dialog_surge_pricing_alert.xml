<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:padding="16dp">

    <!-- Card Container -->
    <androidx.cardview.widget.CardView
        android:id="@+id/cardContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        app:cardBackgroundColor="@color/surge_card_bg"
        app:cardCornerRadius="16dp"
        app:cardElevation="8dp">

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <!-- Content Container -->
            <LinearLayout
                android:id="@+id/contentContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="20dp">

                <!-- Icon Section with red circle background -->
                <FrameLayout
                    android:layout_width="64dp"
                    android:layout_height="64dp"
                    android:layout_gravity="center_horizontal"
                    android:layout_marginBottom="16dp">

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:background="@drawable/surge_icon_circle_bg" />

                    <ImageView
                        android:id="@+id/dialogIcon"
                        android:layout_width="32dp"
                        android:layout_height="32dp"
                        android:layout_gravity="center"
                        android:src="@drawable/ic_surge_alert_triangle"
                        android:scaleType="fitCenter"
                        android:tint="@android:color/white" />

                </FrameLayout>

                <!-- Title Section -->
                <LinearLayout
                    android:id="@+id/titleSection"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                  <TextView
                    android:id="@+id/titleText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingHorizontal="24dp"
                    android:gravity="center"
                    android:text="@string/surge_pricing_title"
                    android:textAlignment="center"
                    android:textColor="@color/surge_text_primary"
                    android:textSize="24sp"
                    android:textStyle="bold" />
                </LinearLayout>

                <!-- Separator Line -->
                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginTop="16dp"
                    android:layout_marginBottom="16dp"
                    android:layout_marginHorizontal="20dp"
                    android:background="@color/surge_border" />

                <!-- Fee Section with Yellow Background -->
                <LinearLayout
                    android:id="@+id/feeSection"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_margin="12dp"
                    android:background="@drawable/surge_fee_section_bg"
                    android:orientation="vertical">

                    <!-- Current Fee Row (Surge) -->
                    <LinearLayout
                        android:id="@+id/surgeFeeRow"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:layout_marginTop="6dp"
                            android:layout_marginBottom="12dp"
                            android:text="@string/surge_current_fee"
                            android:textColor="@color/surge_text_primary"
                            android:textSize="14sp"
                            android:textStyle="normal" />

                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="6dp"
                            android:orientation="horizontal"
                            android:gravity="center_vertical">

                            <TextView
                                android:id="@+id/surgeFeeValue"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="0.003 FLOW"
                                android:textColor="@color/surge_text_primary"
                                android:textSize="14sp"
                                android:textStyle="normal" />

                            <ImageView
                                android:layout_width="16dp"
                                android:layout_height="16dp"
                                android:layout_marginStart="4dp"
                                android:src="@drawable/ic_coin_flow"
                                android:scaleType="fitCenter" />

                        </LinearLayout>

                    </LinearLayout>

                  <LinearLayout
                    android:id="@+id/surgeFeeRow2"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <ImageView
                      android:layout_width="16dp"
                      android:layout_height="16dp"
                      android:layout_marginEnd="4dp"
                      android:src="@drawable/ic_surge_active"
                      android:scaleType="fitCenter" />

                    <TextView
                      android:layout_width="0dp"
                      android:layout_height="wrap_content"
                      android:layout_weight="1"
                      android:text="@string/surge_active"
                      android:textColor="@color/surge_warning"
                      android:textSize="14sp"
                      android:textStyle="bold" />

                  </LinearLayout>

                    <!-- Description Text -->
                    <TextView
                        android:id="@+id/descriptionText"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:layout_marginBottom="6dp"
                        android:lineSpacingMultiplier="1.2"
                        android:text="@string/surge_description"
                        android:textColor="@color/surge_warning"
                        android:textSize="14sp" />

                </LinearLayout>

                <!-- Hold to Confirm Button -->
                <FrameLayout
                    android:layout_margin="12dp"
                    android:id="@+id/holdButtonContainer"
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    android:layout_marginTop="20dp"
                    android:background="@drawable/surge_button_bg">

                    <!-- Circular Progress Indicator (like hold to send) -->
                    <com.google.android.material.progressindicator.CircularProgressIndicator
                        android:id="@+id/progressIndicator"
                        android:layout_width="28dp"
                        android:layout_height="28dp"
                        android:layout_gravity="center_vertical|start"
                        android:layout_marginStart="12dp"
                        app:indicatorColor="@android:color/white"
                        app:indicatorInset="4dp"
                        app:indicatorSize="28dp"
                        app:trackColor="#66FFFFFF"
                        app:trackCornerRadius="4dp"
                        app:trackThickness="4dp"
                        android:progress="0"
                        android:visibility="visible" />

                    <!-- Button Text -->
                    <TextView
                        android:id="@+id/holdButtonText"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center_vertical"
                        android:layout_marginStart="52dp"
                        android:layout_marginEnd="12dp"
                        android:text="@string/surge_hold_to_confirm"
                        android:textColor="@android:color/white"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        android:lines="1"
                        android:maxLines="1"
                        app:autoSizeTextType="uniform"
                        app:autoSizeMinTextSize="8sp" />

                </FrameLayout>

            </LinearLayout>

            <!-- Close Button (X) - Positioned absolutely -->
            <TextView
                android:id="@+id/closeButton"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_gravity="top|end"
                android:background="?android:attr/selectableItemBackgroundBorderless"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:padding="8dp"
                android:text="✕"
                android:textColor="@color/surge_text_secondary"
                android:textSize="20sp" />

        </FrameLayout>

    </androidx.cardview.widget.CardView>

</FrameLayout>
