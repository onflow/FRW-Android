<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
  xmlns:app="http://schemas.android.com/apk/res-auto"
  xmlns:tools="http://schemas.android.com/tools"
  android:id="@+id/cl_wallet_address"
  android:layout_width="match_parent"
  android:layout_height="wrap_content"
  android:paddingHorizontal="5dp"
  app:layout_constraintTop_toBottomOf="@id/tv_connecting_account">

  <TextView
    android:id="@+id/tv_account_icon"
    android:layout_width="36dp"
    android:layout_height="36dp"
    android:background="@drawable/bg_round_24dp"
    android:backgroundTint="@color/emoji_peach"
    android:gravity="center"
    android:text="🍑"
    android:textSize="18sp"
    app:layout_constraintBottom_toBottomOf="parent"
    app:layout_constraintStart_toStartOf="parent"
    app:layout_constraintTop_toTopOf="parent"/>

  <TextView
    android:id="@+id/tv_account_name"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:layout_marginStart="16dp"
    android:fontFamily="@font/inter"
    android:lines="1"
    android:textColor="@color/text_2"
    android:textSize="14sp"
    android:textStyle="bold"
    app:layout_constrainedWidth="true"
    app:layout_constraintBottom_toTopOf="@id/tv_account_address"
    app:layout_constraintStart_toEndOf="@id/tv_account_icon"
    app:layout_constraintTop_toTopOf="@id/tv_account_icon"
    tools:text="Peach"/>

  <TextView
    android:id="@+id/tv_account_address"
    android:layout_width="0dp"
    android:layout_height="wrap_content"
    android:ellipsize="middle"
    android:fontFamily="@font/inter"
    android:lines="1"
    android:textColor="@color/text_2"
    android:textSize="14sp"
    app:layout_constraintEnd_toEndOf="parent"
    app:layout_constraintStart_toStartOf="@id/tv_account_name"
    app:layout_constraintTop_toBottomOf="@id/tv_account_name"
    app:layout_constraintBottom_toTopOf="@id/tv_account_balance"
    tools:text="0x0c666c888d8fb999"/>

  <TextView
    android:id="@+id/tv_account_balance"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:fontFamily="@font/inter"
    android:lines="1"
    android:textColor="@color/text_3"
    android:textSize="14sp"
    app:layout_constrainedWidth="true"
    app:layout_constraintBottom_toBottomOf="@id/tv_account_icon"
    app:layout_constraintStart_toStartOf="@id/tv_account_name"
    app:layout_constraintTop_toBottomOf="@id/tv_account_address"
    tools:text="$99.66"/>

  <TextView
    android:id="@+id/tv_evm_label"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:layout_marginStart="8dp"
    android:layout_marginEnd="2dp"
    android:background="@drawable/bg_round_corner"
    android:backgroundTint="@color/accent_purple"
    android:fontFamily="@font/inter"
    android:paddingHorizontal="8dp"
    android:text="@string/label_evm"
    android:textColor="@color/white"
    android:textSize="9sp"
    android:visibility="gone"
    app:layout_constraintBottom_toBottomOf="@id/tv_account_name"
    app:layout_constraintStart_toEndOf="@id/tv_account_name"
    app:layout_constraintTop_toTopOf="@id/tv_account_name"/>
</androidx.constraintlayout.widget.ConstraintLayout>

